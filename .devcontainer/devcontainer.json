{
  "name": "Delta Lake Dev",
  "image": "mcr.microsoft.com/devcontainers/java:17-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.10"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "scalameta.metals"
      ],
      "settings": {
        "metals.sbtScript": "${containerWorkspaceFolder}/build/sbt"
      }
    }
  },
  "postCreateCommand": "echo 'Dev container ready. Run: build/sbt compile'"
}
